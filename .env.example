# ── Checkout embebido (Stripe) ─────────────────────────────────────────
# Copia este archivo a .env.local (o configura estas variables en tu CI/
# hosting) para activar el pago real dentro de la web. Sin ellas, el
# checkout funciona en "modo demo" (simulación, sin cobro).

# Clave PUBLICABLE de Stripe (segura para el frontend)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# URL de la función serverless que crea la suscripción
# (ver api/create-subscription.js; despliégala en Vercel/Netlify/CF Workers)
VITE_CHECKOUT_ENDPOINT=https://tu-funcion.vercel.app/api/create-subscription

# ── (Opcional) Enlaces de pago directos de Stripe ──────────────────────
# Alternativa sin backend: Payment Links por plan y periodo. Si prefieres
# el checkout embebido de arriba, puedes dejarlos vacíos.
VITE_PAY_ASISTENTE_MENSUAL=
VITE_PAY_ASISTENTE_ANUAL=
VITE_PAY_OPERATIVO_MENSUAL=
VITE_PAY_OPERATIVO_ANUAL=
VITE_PAY_UNLIMITED_MENSUAL=
VITE_PAY_UNLIMITED_ANUAL=
